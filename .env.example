# Portfolio Configuration & Contact Delivery Settings

# Personal email destination where contact submissions will be delivered
CONTACT_EMAIL=your.email@example.com

# Outgoing "From" display address (e.g. "Portfolio Inquiry" <noreply@yourdomain.com>)
MAIL_FROM_EMAIL="Portfolio Contact" <noreply@yourdomain.com>

# Nodemailer SMTP Configuration (e.g., Gmail, SendGrid, Resend SMTP, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.smtp.username@gmail.com
SMTP_PASSWORD=your_app_specific_password_or_token

# (Optional) MailerSend API Key if using MailerSend instead of SMTP
MAILERSEND_API_KEY=
